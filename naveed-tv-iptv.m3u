
```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>PTV Live Player</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/hls.js/1.4.12/hls.min.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu&family=Oswald:wght@400;600;700&display=swap');

  *{margin:0;padding:0;box-sizing:border-box}
  :root{
    --green:#00c853;--dark:#0a0f0a;--card:#111a11;
    --border:#1e3a1e;--text:#e8f5e9;--muted:#4caf50;
  }
  body{background:var(--dark);color:var(--text);font-family:'Oswald',sans-serif;min-height:100vh}

  header{
    background:linear-gradient(135deg,#003300,#001a00);
    border-bottom:2px solid var(--green);
    padding:14px 24px;
    display:flex;align-items:center;gap:14px;
  }
  .logo{
    width:44px;height:44px;border-radius:50%;
    background:linear-gradient(135deg,var(--green),#69f0ae);
    display:flex;align-items:center;justify-content:center;
    font-size:20px;font-weight:700;color:#000;box-shadow:0 0 18px #00c85388;
  }
  header h1{font-size:1.5rem;letter-spacing:2px;color:var(--green)}
  header span{font-size:.8rem;color:#81c784;margin-left:auto;letter-spacing:1px}

  .app{display:grid;grid-template-columns:280px 1fr;height:calc(100vh - 70px)}

  /* Sidebar */
  .sidebar{background:#0d150d;border-right:1px solid var(--border);overflow-y:auto;padding:12px 0}
  .sidebar::-webkit-scrollbar{width:4px}
  .sidebar::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}

  .group-label{
    font-size:.65rem;letter-spacing:3px;color:#4caf50;
    padding:14px 18px 6px;text-transform:uppercase;
    border-top:1px solid var(--border);margin-top:6px;
  }
  .group-label:first-child{border-top:none;margin-top:0}

  .ch-item{
    display:flex;align-items:center;gap:12px;
    padding:11px 18px;cursor:pointer;
    transition:background .15s;border-left:3px solid transparent;
  }
  .ch-item:hover{background:#162416}
  .ch-item.active{background:#0e2a0e;border-left-color:var(--green)}
  .ch-icon{
    width:36px;height:36px;border-radius:8px;
    background:linear-gradient(135deg,#1b5e20,#2e7d32);
    display:flex;align-items:center;justify-content:center;
    font-size:13px;font-weight:700;color:#a5d6a7;flex-shrink:0;
  }
  .ch-item.active .ch-icon{background:linear-gradient(135deg,var(--green),#69f0ae);color:#000}
  .ch-name{font-size:.9rem;letter-spacing:.5px}
  .live-dot{
    width:7px;height:7px;border-radius:50%;background:var(--green);
    margin-left:auto;box-shadow:0 0 6px var(--green);flex-shrink:0;
    animation:pulse 1.4s infinite;
  }
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}

  /* Player area */
  .player-area{display:flex;flex-direction:column;background:#080d08}
  .video-wrap{
    position:relative;background:#000;
    aspect-ratio:16/9;max-height:62vh;width:100%;
  }
  video{width:100%;height:100%;object-fit:contain;background:#000}

  .no-channel{
    position:absolute;inset:0;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:12px;color:#2e5c2e;
  }
  .no-channel .big-icon{font-size:64px}
  .no-channel p{font-size:1.1rem;letter-spacing:1px}

  .loading-overlay{
    position:absolute;inset:0;background:#000a;
    display:flex;align-items:center;justify-content:center;
    flex-direction:column;gap:10px;display:none;
  }
  .loading-overlay.show{display:flex}
  .spinner{
    width:40px;height:40px;border:3px solid #1b5e20;
    border-top-color:var(--green);border-radius:50%;
    animation:spin .8s linear infinite;
  }
  @keyframes spin{to{transform:rotate(360deg)}}

  .channel-info{
    padding:14px 20px;
    border-bottom:1px solid var(--border);
    display:flex;align-items:center;gap:14px;
  }
  .now-playing{font-size:.65rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase}
  .ch-title{font-size:1.3rem;font-weight:600;letter-spacing:1px}
  .badge{
    margin-left:auto;background:var(--green);color:#000;
    font-size:.65rem;font-weight:700;letter-spacing:2px;
    padding:4px 10px;border-radius:4px;
  }

  .error-bar{
    background:#b71c1c;color:#fff;padding:10px 20px;
    font-size:.8rem;letter-spacing:.5px;display:none;
  }
  .error-bar.show{display:block}

  .channel-meta{padding:16px 20px;flex:1}
  .meta-grid{display:flex;gap:16px;flex-wrap:wrap}
  .meta-card{
    background:var(--card);border:1px solid var(--border);
    border-radius:8px;padding:12px 18px;min-width:120px;
  }
  .meta-label{font-size:.6rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;margin-bottom:4px}
  .meta-val{font-size:.95rem;font-weight:600}

  /* Upload area */
  .upload-bar{
    padding:10px 20px;background:#0d150d;
    border-top:1px solid var(--border);
    display:flex;align-items:center;gap:12px;
  }
  .upload-bar label{
    cursor:pointer;background:#1b5e20;border:1px solid var(--green);
    color:var(--green);padding:7px 16px;border-radius:6px;
    font-size:.75rem;letter-spacing:1px;transition:background .15s;
  }
  .upload-bar label:hover{background:#2e7d32}
  #fileInput{display:none}
  .upload-bar span{font-size:.75rem;color:#4caf50;letter-spacing:.5px}

  @media(max-width:700px){
    .app{grid-template-columns:1fr;grid-template-rows:auto 1fr}
    .sidebar{max-height:220px;overflow-y:auto;border-right:none;border-bottom:1px solid var(--border)}
    .video-wrap{max-height:45vw}
  }
</style>
</head>
<body>

<header>
  <div class="logo">📺</div>
  <h1>PTV LIVE</h1>
  <span>🟢 LIVE STREAMING</span>
</header>

<div class="app">
  <div class="sidebar" id="sidebar"></div>

  <div class="player-area">
    <div class="channel-info" id="channelInfo">
      <div>
        <div class="now-playing">Now Playing</div>
        <div class="ch-title" id="chTitle">Channel select karein</div>
      </div>
      <span class="badge" id="liveBadge" style="display:none">● LIVE</span>
    </div>

    <div class="error-bar" id="errorBar">⚠️ Stream load nahi ho saka. Internet check karein ya doosra channel try karein.</div>

    <div class="video-wrap">
      <div class="no-channel" id="noChannel">
        <div class="big-icon">📡</div>
        <p>Koi bhi channel select karein</p>
      </div>
      <div class="loading-overlay" id="loadingOverlay">
        <div class="spinner"></div>
        <div style="font-size:.8rem;letter-spacing:1px;color:#81c784">Loading stream...</div>
      </div>
      <video id="player" controls></video>
    </div>

    <div class="channel-meta">
      <div class="meta-grid" id="metaGrid">
        <div class="meta-card"><div class="meta-label">Total Channels</div><div class="meta-val" id="totalCh">—</div></div>
        <div class="meta-card"><div class="meta-label">Groups</div><div class="meta-val" id="totalGr">—</div></div>
        <div class="meta-card"><div class="meta-label">Stream Type</div><div class="meta-val">HLS / M3U8</div></div>
        <div class="meta-card"><div class="meta-label">Player</div><div class="meta-val">HLS.js</div></div>
      </div>
    </div>

    <div class="upload-bar">
      <label for="fileInput">📂 Apni M3U File Upload Karein</label>
      <input type="file" id="fileInput" accept=".m3u,.m3u8,.txt">
      <span id="uploadStatus">Ya neeche built-in channels use karein</span>
    </div>
  </div>
</div>

<script>
const DEFAULT_M3U = `#EXTM3U

#EXTINF:-1 tvg-name="PTV Home" group-title="PTV",PTV Home
https://ythls.armelin.one/channel/UC4p_I9eiRewISYPOGZGFSkg.m3u8

#EXTINF:-1 tvg-name="PTV News" group-title="PTV",PTV News
https://ythls.armelin.one/channel/UCkqc6H4PtFWrTyX8H8zVBpA.m3u8

#EXTINF:-1 tvg-name="PTV Sports" group-title="PTV",PTV Sports
https://ythls.armelin.one/channel/UC4p_I9eiRewISYPOGZGFSkg.m3u8

#EXTINF:-1 tvg-name="PTV Global" group-title="PTV",PTV Global
https://ythls.armelin.one/channel/UC4p_I9eiRewISYPOGZGFSkg.m3u8

#EXTINF:-1 tvg-name="Geo News" group-title="Pakistan",Geo News
https://ythls.armelin.one/channel/UCxEhn6z1K3Qm5yF8Gq0y0nA.m3u8

#EXTINF:-1 tvg-name="ARY News" group-title="Pakistan",ARY News
https://ythls.armelin.one/channel/UC4JCksJF76g_MdzPVBJoC3Q.m3u8

#EXTINF:-1 tvg-name="Samaa News" group-title="Pakistan",Samaa News
https://ythls.armelin.one/channel/UCJekW1Vj5fCVEGdye_mBN6Q.m3u8

#EXTINF:-1 tvg-name="Sky Sports News" group-title="Sports",Sky Sports News
https://ythls.armelin.one/channel/UCoMdktPbSTixAyNGwb-UYkQ.m3u8`;

function parseM3U(text) {
  const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
  const channels = [];
  for (let i = 0; i < lines.length; i++) {
    if (lines[i].startsWith('#EXTINF')) {
      const info = lines[i];
      const url = lines[i + 1] && !lines[i + 1].startsWith('#') ? lines[i + 1] : null;
      if (!url) continue;
      const nameMatch = info.match(/,(.+)$/);
      const groupMatch = info.match(/group-title="([^"]*)"/);
      channels.push({
        name: nameMatch ? nameMatch[1].trim() : 'Unknown',
        group: groupMatch ? groupMatch[1].trim() : 'Other',
        url
      });
      i++;
    }
  }
  return channels;
}

function groupChannels(channels) {
  const groups = {};
  channels.forEach(ch => {
    if (!groups[ch.group]) groups[ch.group] = [];
    groups[ch.group].push(ch);
  });
  return groups;
}

function initials(name) {
  return name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
}

let hls = null;
let currentIdx = null;
let allChannels = [];

function renderSidebar(channels) {
  const sidebar = document.getElementById('sidebar');
  const groups = groupChannels(channels);
  sidebar.innerHTML = '';
  allChannels = channels;

  document.getElementById('totalCh').textContent = channels.length;
  document.getElementById('totalGr').textContent = Object.keys(groups).length;

  Object.entries(groups).forEach(([group, chs]) => {
    const label = document.createElement('div');
    label.className = 'group-label';
    label.textContent = group;
    sidebar.appendChild(label);

    chs.forEach(ch => {
      const idx = channels.indexOf(ch);
      const item = document.createElement('div');
      item.className = 'ch-item';
      item.id = 'ch-' + idx;
      item.innerHTML = `
        <div class="ch-icon">${initials(ch.name)}</div>
        <span class="ch-name">${ch.name}</span>
        <div class="live-dot"></div>
      `;
      item.onclick = () => playChannel(idx);
      sidebar.appendChild(item);
    });
  });
}

function playChannel(idx) {
  const ch = allChannels[idx];
  if (!ch) return;

  // UI updates
  if (currentIdx !== null) {
    const prev = document.getElementById('ch-' + currentIdx);
    if (prev) prev.classList.remove('active');
  }
  currentIdx = idx;
  const curr = document.getElementById('ch-' + idx);
  if (curr) { curr.classList.add('active'); curr.scrollIntoView({block:'nearest'}); }

  document.getElementById('chTitle').textContent = ch.name;
  document.getElementById('liveBadge').style.display = '';
  document.getElementById('noChannel').style.display = 'none';
  document.getElementById('errorBar').classList.remove('show');
  document.getElementById('loadingOverlay').classList.add('show');

  const video = document.getElementById('player');

  if (hls) { hls.destroy(); hls = null; }

  if (Hls.isSupported()) {
    hls = new Hls({ enableWorker: false });
    hls.loadSource(ch.url);
    hls.attachMedia(video);
    hls.on(Hls.Events.MANIFEST_PARSED, () => {
      document.getElementById('loadingOverlay').classList.remove('show');
      video.play().catch(()=>{});
    });
    hls.on(Hls.Events.ERROR, (e, data) => {
      if (data.fatal) {
        document.getElementById('loadingOverlay').classList.remove('show');
        document.getElementById('errorBar').classList.add('show');
      }
    });
  } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
    video.src = ch.url;
    video.addEventListener('loadedmetadata', () => {
      document.getElementById('loadingOverlay').classList.remove('show');
      video.play().catch(()=>{});
    });
  } else {
    document.getElementById('loadingOverlay').classList.remove('show');
    document.getElementById('errorBar').classList.add('show');
  }
}

// File upload
document.getElementById('fileInput').addEventListener('change', e => {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    const channels = parseM3U(ev.target.result);
    if (channels.length === 0) {
      document.getElementById('uploadStatus').textContent = '⚠️ Koi valid channel nahi mila';
      return;
    }
    document.getElementById('uploadStatus').textContent = `✅ ${file.name} — ${channels.length} channels loaded`;
    renderSidebar(channels);
  };
  reader.readAsText(file);
});

// Init
const channels = parseM3U(DEFAULT_M3U);
renderSidebar(channels);
</script>
</body>
</html>
```
